{
  "name": "slidecold-mcp",
  "version": "0.1.0",
  "description": "Official SlideCold MCP server: every SlideCold API operation as an MCP tool.",
  "license": "MIT",
  "author": "SlideCold",
  "homepage": "https://github.com/slidecold/slidecold-node#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slidecold/slidecold-node.git",
    "directory": "packages/slidecold-mcp"
  },
  "bugs": "https://github.com/slidecold/slidecold-node/issues",
  "keywords": ["slidecold", "mcp", "model-context-protocol", "instagram", "claude"],
