{
  "name": "slidecold",
  "version": "0.1.0",
  "description": "Official SlideCold Node.js SDK and CLI for the SlideCold Instagram cold-DM API.",
  "license": "MIT",
  "author": "SlideCold",
  "homepage": "https://github.com/slidecold/slidecold-node#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slidecold/slidecold-node.git",
    "directory": "packages/slidecold"
  },
  "bugs": "https://github.com/slidecold/slidecold-node/issues",
  "keywords": ["slidecold", "instagram", "dm", "outreach", "sdk", "cli", "api"],
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "slidecold": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs"
  }
}
